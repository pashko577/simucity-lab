# Copiar a .env (que NO se sube a Git) y completar.

# Contraseña de PostgreSQL. Genera una larga y aleatoria, p. ej.: openssl rand -base64 32
DB_PASSWORD=

# true siempre que el sitio se sirva por HTTPS (producción). En http://localhost los navegadores aceptan
# cookies Secure; pon false solo si accedes por http desde otra máquina (no recomendado).
SECURE_COOKIES=true

# Dónde publica nginx. 127.0.0.1 = solo esta máquina; detrás de un proxy HTTPS, déjalo así.
HTTP_BIND=127.0.0.1
HTTP_PORT=8081
